# main 

#theme = monochrome-gray.theme 
minimum-contrast = 1.05
# theme = light:Gruvbox Light,dark:Gruvbox Dark   
# theme = Black Metal (Mayhem) 
# theme = light:Iceberg Light, dark:Black Metal (Immortal) 
theme = Black Metal (Immortal) 
# theme = Batman
auto-update = download 


# window options #
window-decoration = false  
window-padding-x = 0
window-padding-y = 0  
window-padding-color = extend-always
window-save-state = always 
gtk-titlebar = true 
title = " "
mouse-hide-while-typing = true
scrollback-limit = 10000
adjust-cell-height = -10%
# font options # 

# font-family = "Paper Mono Regular"  
font-family = "IBM Plex Mono"
font-size = 14
copy-on-select = true

# cursor style 
cursor-color = #008000
cursor-style-blink = true
cursor-style = block
