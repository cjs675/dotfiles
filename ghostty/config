#theme = monochrome-gray.theme 
minimum-contrast = 1.05
# theme = light:Gruvbox Light,dark:Gruvbox Dark   
# theme = Black Metal (Mayhem) 
# theme = light:Iceberg Light, dark:Black Metal (Immortal) 
theme = Black Metal (Immortal) 
# theme = Batman
auto-update = download 

###  window options ###
window-decoration = false  
window-padding-x = 0
window-padding-y = 0  
window-padding-color = extend-always
window-save-state = always 
gtk-titlebar = true 
title = " "
mouse-hide-while-typing = true
scrollback-limit = 10000
adjust-cell-height = -15% 
background-opacity = 0.92
background-blur-radius = 20

### font options ### 
# font-family = "Paper Mono Regular"   
# font-family = "Jetbrains Mono Extra Light" 
# font-family = "IBM Plex Mono"  
# font-family = "Geist Mono"
# font-family = "ShareTechMono-Regular" 
# font-family = "IronMono-SemiBold" 
font-family = "IronMono-Bold"
font-size = 14
copy-on-select = true

# cursor style 
cursor-color = #008000
cursor-style-blink = false 
cursor-style = block 

###  misc ###  
selection-invert-fg-bg = true
clipboard-read = allow
clipboard-write = allow 
custom-shader = ~/Dotfiles/ghostty/shaders/cursor_warp.glsl
